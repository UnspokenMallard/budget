<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Fafnir server (~/.budget/server/app.py): the spend ledger API on 127.0.0.1:3025.
     Installed as ~/Library/LaunchAgents/com.budget.server.plist by ~/.budget/bin/install-launchd. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.budget.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/anzes/.budget/.venv/bin/python</string>
		<string>/Users/anzes/.budget/server/app.py</string>
	</array>
	<key>WorkingDirectory</key>
	<string>/Users/anzes/.budget</string>
	<key>EnvironmentVariables</key>
	<dict>
		<key>LANG</key>
		<string>en_US.UTF-8</string>
	</dict>
	<key>StandardOutPath</key>
	<string>/Users/anzes/.budget/state/logs/server.log</string>
	<key>StandardErrorPath</key>
	<string>/Users/anzes/.budget/state/logs/server.log</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
</dict>
</plist>
